{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@npv12/opencode-recap",
  "version": "0.4.7",
  "description": "Sidebar session recaps for the OpenCode V2 TUI",
  "type": "module",
  "license": "MIT",
  "author": "Pranav <pranav10121@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/npv12/opencode-recap.git"
  },
  "homepage": "https://github.com/npv12/opencode-recap#readme",
  "bugs": "https://github.com/npv12/opencode-recap/issues",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "tui",
    "recap",
    "sidebar"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./tui": "./dist/tui.js"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "bun scripts/build.ts",
    "build:watch": "bun --watch scripts/build.ts",
    "check": "bun run typecheck && bun run test",
    "prepack": "bun run build",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@opencode/plugin": "2.0.10",
    "@opentui/core": "0.5.11",
    "@opentui/solid": "0.5.11",
    "solid-js": "1.9.15"
  },
  "devDependencies": {
    "@tsconfig/bun": "1.0.9",
    "@types/bun": "1.3.5",
    "typescript": "5.9.3"
  }
}
